---
import { Icon } from "astro-icon/components";

interface Props {
  label: string;
  icon: string;
  level: "Principiante" | "Intermedio" | "Avanzado";
}

const levelColors: Record<string, string> = {
  Principiante: "bg-level-beginner",
  Intermedio: "bg-level-intermediate",
  Avanzado: "bg-level-advanced",
};

const { label, icon, level } = Astro.props;
---

<div class="flex items-center gap-4 rounded-2xl border border-gray-muted bg-black-dark p-4 transition-colors duration-200 hover:border-gray-slate">
  <div class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-black-deep">
    <Icon name={icon} class="text-gray-blue" />
  </div>

  <div class="flex-1">
    <div class="flex items-center justify-between">
      <span class="text-sm font-semibold tracking-widest text-gray-light">
        {label}
      </span>

      <span
        class={`rounded-full px-2.5 py-1 text-xs font-medium text-gray-light ${levelColors[level]}`}
      >
        {level}
      </span>
    </div>
  </div>
</div>
