---
import { Icon } from "astro-icon/components";

interface Props {
  label: string;
  icon: string;
  level: "Principiante" | "Intermedio" | "Avanzado";
}

const levelColors: Record<string, string> = {
  Principiante: "bg-level-beginner",
  Intermedio: "bg-level-intermediate",
  Avanzado: "bg-level-advanced",
};

const { label, icon, level } = Astro.props;
---

<div class="flex items-center gap-3 rounded-2xl border border-gray-muted bg-black-dark p-3 transition-colors duration-200 hover:border-gray-slate sm:gap-4 sm:p-3.5 lg:p-4">
  <div class="flex size-9 shrink-0 items-center justify-center rounded-xl bg-black-deep sm:size-10">
    <Icon name={icon} class="text-base text-gray-blue sm:text-lg" />
  </div>

  <div class="min-w-0 flex-1">
    <div class="flex items-center justify-between gap-2">
      <span
        class="truncate text-xs font-semibold tracking-wide text-gray-light sm:text-sm"
        title={label}
      >
        {label}
      </span>

      <span
        class={`shrink-0 rounded-full px-2 py-0.5 text-[11px] font-medium text-gray-light sm:px-2.5 sm:py-1 sm:text-xs ${levelColors[level]}`}
      >
        {level}
      </span>
    </div>
  </div>
</div>
