---
interface Props {
  id?: string;
  tone?: "deep" | "dark";
  width?: "narrow" | "wide";
}

const { id, tone = "deep", width = "wide" } = Astro.props;

const toneClass = tone === "dark" ? "bg-black-dark" : "bg-black-deep";
const widthClass = width === "narrow" ? "max-w-4xl" : "max-w-6xl";
---

<section id={id} class:list={[toneClass, "py-14 sm:py-20 lg:py-28"]}>
  <div class:list={["mx-auto px-5 sm:px-8 lg:px-12", widthClass]}>
    <slot />
  </div>
</section>
