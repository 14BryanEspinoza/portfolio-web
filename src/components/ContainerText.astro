---
interface Props {
  title: string;
  subtitle?: string;
  description?: string;
  heading?: boolean;
  classNameDiv?: string;
}

const styleDisplay = "text-display font-bold text-balance text-gray-light";
const styleHeading = "text-heading font-bold text-balance text-gray-light";
const styleSubtitle =
  "text-xs font-bold font-mono uppercase tracking-[0.12em] text-indigo-soft";
const styleBody =
  "mx-auto max-w-[68ch] text-base leading-relaxed text-pretty text-gray-blue lg:text-lg";

const {
  title,
  subtitle,
  description,
  heading,
  classNameDiv = "",
} = Astro.props;
---

<div
  class=`mx-auto flex max-w-3xl flex-col gap-3 px-5 mb-10 sm:gap-4 sm:px-8 md:mb-14 lg:px-12 ${classNameDiv}`
>
  {subtitle && <p class={styleSubtitle}>{subtitle}</p>}

  {heading ? (
    <h1 class={styleDisplay}>{title}</h1>
  ) : (
    <h2 class={styleHeading}>{title}</h2>
  )}

  <p class={styleBody}>
    <slot /> {description}
  </p>
</div>
