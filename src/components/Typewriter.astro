---
interface Props {
  className?: string;
}

const { className = "" } = Astro.props;
---

<div class={`mx-auto w-full max-w-xs py-4 md:max-w-sm ${className}`}>
  <span class="typewriter font-mono text-sm text-gray-slate md:text-base">
    Hello World...
  </span>
</div>

<style>
  .typewriter {
    --chars: 14;
    --tracking: 0.25em;

    display: inline-block;
    overflow: hidden;
    border-right: 2px solid var(--color-gray-slate);
    white-space: nowrap;
    letter-spacing: var(--tracking);
    width: 0;
    animation:
      typing 3s steps(var(--chars), end) forwards,
      blink 0.8s step-end infinite;
  }

  @keyframes typing {
    from {
      width: 0;
    }
    to {
      width: calc(var(--chars) * 1ch + var(--chars) * var(--tracking) + 2px);
    }
  }

  @keyframes blink {
    50% {
      border-color: transparent;
    }
  }
</style>
