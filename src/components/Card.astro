---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import Link from "@components/Link.astro";
import Topic from "@components/Topic.astro";

interface Props {
  title: string;
  description: string;
  image: ImageMetadata;
  imageAlt: string;
  topic: Array<string>;
  url: {
    demo: string;
    repo: string;
  };
}

const { title, description, topic, image, imageAlt, url } = Astro.props;
---

<article class="group flex flex-col overflow-hidden rounded-2xl border border-gray-muted bg-black-dark transition-all duration-300 hover:border-gray-slate hover:shadow-lg hover:shadow-indigo-vibrant/5">
  <div class="relative aspect-video overflow-hidden">
    <Picture
      src={image}
      alt={imageAlt}
      width={400}
      formats={["avif", "webp"]}
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
  </div>

  <div class="flex flex-1 flex-col p-6">
    <div class="mb-4 flex flex-wrap gap-2">
      {topic.map((topic) => (
        <Topic topic={topic} />
      ))}
    </div>

    <h2 class="mb-2 text-xl font-bold text-gray-light">{title}</h2>

    <p class="mb-6 line-clamp-3 text-sm leading-relaxed text-balance text-gray-blue">
      {description}
    </p>

    <div class="mt-auto flex gap-4">
      <Link
        url={url.demo}
        label="Demo"
        icon="lucide:link"
        targ
        className="inline-flex h-full flex-1 items-center justify-center gap-2 rounded-xl bg-indigo-vibrant py-3 text-gray-light transition-all duration-200 hover:bg-indigo-soft hover:shadow-md hover:shadow-indigo-vibrant/20"
      />

      <Link
        url={url.repo}
        icon="simple-icons:github"
        targ
        className="flex items-center justify-center rounded-xl bg-black-deep p-4 text-gray-light transition-colors duration-200 hover:bg-gray-muted"
      />
    </div>
  </div>
</article>
