---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import Link from "@components/Link.astro";
import Topic from "@components/Topic.astro";

interface Props {
  title: string;
  description: string;
  image: ImageMetadata;
  imageAlt: string;
  topic: Array<string>;
  url: {
    demo: string;
    repo: string;
  };
  featured?: boolean;
}

const {
  title,
  description,
  topic,
  image,
  imageAlt,
  url,
  featured = false,
} = Astro.props;
---

<article
  class:list={[
    "group flex flex-col overflow-hidden rounded-2xl border border-gray-muted bg-black-dark transition-all duration-300 hover:border-gray-slate hover:shadow-lg hover:shadow-indigo-vibrant/5",
    featured && "sm:col-span-2 lg:col-span-3 lg:flex-row",
  ]}
>
  <div
    class:list={[
      "relative aspect-video overflow-hidden",
      featured && "lg:w-1/2 lg:shrink-0",
    ]}
  >
    <Picture
      src={image}
      alt={imageAlt}
      widths={featured ? [640, 1280] : [400, 800]}
      sizes={
        featured
          ? "(min-width: 1024px) 50vw, 100vw"
          : "(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
      }
      formats={["avif", "webp"]}
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
  </div>

  <div
    class:list={[
      "flex flex-1 flex-col p-6",
      featured && "lg:justify-center lg:p-10",
    ]}
  >
    <div class="mb-4 flex flex-wrap gap-2">
      {topic.map((topic) => (
        <Topic topic={topic} />
      ))}
    </div>

    <h3
      class:list={[
        "mb-2 font-bold text-gray-light",
        featured ? "text-2xl lg:text-3xl" : "text-xl",
      ]}
    >
      {title}
    </h3>

    <p
      class:list={[
        "mb-6 font-sans text-sm leading-relaxed text-pretty text-gray-blue",
        featured ? "line-clamp-4 lg:text-base" : "line-clamp-3",
      ]}
    >
      {description}
    </p>

    <div class="mt-auto flex gap-4">
      <Link
        url={url.demo}
        label="Demo"
        ariaLabel={`Ver demo de ${title}`}
        icon="lucide:link"
        targ
        className="inline-flex h-full flex-1 items-center justify-center gap-2 rounded-xl bg-indigo-vibrant py-3 text-gray-light transition-all duration-200 hover:bg-indigo-deep hover:shadow-md hover:shadow-indigo-vibrant/20"
      />

      <Link
        url={url.repo}
        ariaLabel={`Repositorio de ${title}`}
        icon="simple-icons:github"
        targ
        className="flex items-center justify-center rounded-xl bg-black-deep p-4 text-gray-light transition-colors duration-200 hover:bg-gray-muted"
      />
    </div>
  </div>
</article>
