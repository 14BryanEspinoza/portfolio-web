---
import { Icon } from "astro-icon/components";
import Badged from "./Badged.astro";

const styleContainer = "p-4 rounded-2xl border bg-black-deep border-gray-muted";
---

<div class="rounded-2xl border border-gray-muted bg-black-deep p-6 transition-colors duration-200 hover:border-gray-slate md:mb-0">
  <h3 class="mb-4 flex items-center gap-3 font-bold text-gray-light">
    <Icon name="lucide:target" class="text-xl text-blue-ocean" />
    Mis metas
  </h3>

  <div class="grid grid-cols-1 gap-4">
    <div class={styleContainer}>
      <Badged
        title="Full-Stack Developer"
        description="Dominar tanto el frontend como el backend para construir aplicaciones completas y escalables."
        icon="lucide:code"
        className="flex-col items-start border-none bg-transparent"
      />
    </div>

    <div class={styleContainer}>
      <Badged
        title="Software Engineer"
        description="Profundizar en la ingeniería de software para diseñar sistemas robustos y de alta calidad"
        icon="lucide:laptop"
        className="flex-col items-start border-none bg-transparent"
      />
    </div>
  </div>
</div>
