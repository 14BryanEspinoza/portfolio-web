---
import { Icon } from "astro-icon/components";

interface Props {
  label: string;
  type: "submit" | "button" | "reset";
  icon?: string;
  className?: string;
  disabled?: boolean;
}

const styleButton =
  "w-full flex items-center justify-center gap-2 px-4 py-3 bg-indigo-vibrant text-gray-light font-semibold rounded-xl transition-all duration-200 hover:bg-indigo-deep hover:shadow-md hover:shadow-indigo-vibrant/20 active:scale-95 cursor-pointer disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-60";

const {
  label,
  type,
  icon,
  className = "",
  disabled = false,
  ...rest
} = Astro.props;
---

<button
  type={type}
  disabled={disabled}
  class={`${styleButton} ${className}`}
  {...rest}
>
  <span data-label>{label}</span>
  {icon && <Icon name={icon} class="text-lg" aria-hidden="true" />}
</button>
