---
import type { HTMLAttributes } from "astro/types";

interface Props {
  name: string;
  label: string;
  type: HTMLAttributes<"input">["type"];
  placeholder?: string;
  element?: "input" | "textarea";
  autocomplete?: string;
}

const styleInput =
  "w-full px-4 py-3 rounded-xl bg-black-deep border border-gray-line text-gray-light outline-none placeholder:text-gray-slate transition-colors duration-200 focus:border-indigo-vibrant";

const {
  label,
  type,
  name,
  placeholder,
  element = "input",
  autocomplete,
} = Astro.props;
---

<div>
  <label
    for={name}
    class="mb-2 block text-sm font-medium tracking-widest text-gray-light"
  >
    {label}
  </label>

  {element === "input" ? (
    <input
      type={type}
      id={name}
      name={name}
      required
      autocomplete={autocomplete}
      class={styleInput}
      placeholder={placeholder}
    />
  ) : (
    <textarea
      id={name}
      name={name}
      rows="5"
      required
      class={styleInput}
      placeholder={placeholder}
    ></textarea>
  )}
</div>
