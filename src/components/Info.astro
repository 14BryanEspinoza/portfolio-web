---
import Badged from "@components/Badged.astro";
import { Icon } from "astro-icon/components";
import Link from "./Link.astro";
---

<div class="rounded-2xl border border-gray-muted bg-black-deep p-8 transition-colors duration-200 hover:border-gray-slate md:col-span-2">
  <h3 class="mb-4 flex items-center gap-3 font-bold text-gray-light">
    <Icon name="lucide:info" class="text-xl text-blue-ocean" />
    Información rápida
  </h3>

  <div class="md:grid md:grid-cols-2">
    <Badged
      title="Ubicación"
      description="Carazo, Nicaragua"
      icon="lucide:map-pin"
      className="border-none"
    />

    <Badged
      title="Disponibilidad"
      description="Inmediata"
      icon="lucide:briefcase"
      className="border-none"
    />

    <Badged
      title="Inglés"
      description="Principiante (A2)"
      icon="lucide:globe"
      className="border-none"
    />

    <Badged
      title="Intereses"
      description="Open Source · IA en Desarrollo"
      icon="lucide:github"
      className="border-none"
    />

    <div class="col-span-2 mt-4 rounded-2xl bg-linear-to-br from-indigo-vibrant to-indigo-deep p-4 text-gray-light">
      <p class="mb-2 text-xs font-bold tracking-widest text-gray-light uppercase">
        Estado actual
      </p>

      <p class="mb-4 font-bold">Abierto a nuevas oportunidades laborales ❤️‍🔥</p>

      <Link
        url="#contact"
        label="Contáctame"
        icon="lucide:arrow-right"
        className="w-fit rounded-xl bg-gray-light px-8 py-2 font-bold text-indigo-vibrant transition-all duration-200 hover:bg-white hover:shadow-md"
      />
    </div>
  </div>
</div>
