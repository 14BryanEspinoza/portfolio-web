---
import { Icon } from "astro-icon/components";

interface Props {
  title: string;
  icon: string;
}

const { title, icon } = Astro.props;
---

<div class="mb-5 flex items-center gap-3">
  <div class="text-black-deep-600 flex size-8 items-center justify-center rounded-lg bg-gray-blue p-2">
    <Icon name={icon} class="text-sm" />
  </div>

  <h3 class="text-sm font-bold tracking-widest text-gray-light uppercase">
    {title}
  </h3>

  <div class="h-px flex-1 bg-gray-muted"></div>
</div>
