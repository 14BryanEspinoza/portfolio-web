---
import { Icon } from "astro-icon/components";

interface Props {
  title: string;
  description: string;
  icon: string;
  className?: string;
}

const styleLink =
  "flex items-center gap-4 p-4 mb-2 rounded-2xl bg-black-deep text-gray-light border border-gray-muted md:mb-4";
const styleBadged =
  "size-12 flex shrink-0 items-center justify-center rounded-2xl bg-indigo-soft/15 text-indigo-soft";

const { title, description, icon, className = "" } = Astro.props;
---

<div class={styleLink + " " + className}>
  <div class={styleBadged}>
    <Icon name={icon} class="text-lg" />
  </div>

  <div>
    <p class="mb-1 text-xs tracking-[0.12em] text-gray-light uppercase">
      {title}
    </p>

    <p class="text-sm leading-relaxed text-gray-blue">{description}</p>
  </div>
</div>
