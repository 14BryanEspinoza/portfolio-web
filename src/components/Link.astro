---
import { Icon } from "astro-icon/components";

interface Props {
  url: string;
  label?: string;
  targ?: boolean;
  download?: boolean;
  icon?: string;
  skip?: boolean;
  className?: string;
}

const baseStyle =
  "flex gap-2 text-sm transition hover:scale-105 active:scale-95";
const skipStyle =
  "sr-only bg-indigo-vibrant transition focus:not-sr-only focus:absolute focus:top-5 focus:left-6 focus:z-50 focus:px-6 focus:py-2 focus:rounded-md focus:font-bold focus:text-gray-light";

const { url, label, targ, download, icon, skip, className = "" } = Astro.props;
---

<a
  href={url}
  target={targ ? "_blank" : ""}
  rel={targ ? "noopener noreferrer" : ""}
  download={download}
  class={`${skip ? skipStyle : baseStyle} ${className}`}
>
  {icon && <Icon name={icon} class="text-lg" />}
  {label}
</a>
