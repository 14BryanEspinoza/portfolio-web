---
import { Icon } from "astro-icon/components";

interface Props {
  url: string;
  label?: string;
  ariaLabel?: string;
  targ?: boolean;
  download?: boolean;
  icon?: string;
  skip?: boolean;
  className?: string;
}

const baseStyle = "flex gap-2 text-sm transition-colors duration-200";
const skipStyle =
  "sr-only bg-indigo-vibrant transition focus:not-sr-only focus:absolute focus:top-5 focus:left-6 focus:z-50 focus:px-6 focus:py-2 focus:rounded-md focus:font-bold focus:text-gray-light";

const {
  url,
  label,
  ariaLabel,
  targ,
  download,
  icon,
  skip,
  className = "",
} = Astro.props;
---

<a
  href={url}
  target={targ ? "_blank" : undefined}
  rel={targ ? "noopener noreferrer" : undefined}
  download={download}
  aria-label={ariaLabel || undefined}
  class={`${skip ? skipStyle : baseStyle} ${className}`}
>
  {icon && <Icon name={icon} class="text-lg" aria-hidden="true" />}
  {label}
</a>
