---
import { Icon } from "astro-icon/components";
import { linkNavbar } from "@data/links";
import Link from "@components/Link.astro";
---

<a
  href={import.meta.env.BASE_URL}
  class="flex items-center gap-2 text-gray-blue transition-all duration-200 hover:scale-105 hover:text-gray-light active:scale-95"
>
  <figure class="size-8">
    <img
      src={import.meta.env.BASE_URL + "favicon.png"}
      alt="Ir al inicio"
      loading="eager"
    />
  </figure>
  <span class="hidden md:block md:font-extrabold md:tracking-widest">
    14BryanEspinoza
  </span>
</a>

<button
  type="button"
  id="menu-toggle"
  class="cursor-pointer lg:hidden"
  aria-expanded="false"
  aria-controls="nav-main"
  aria-label="menú de navegación"
>
  <Icon
    name="lucide:menu"
    class="text-3xl text-gray-light transition-colors duration-200 hover:text-indigo-soft"
    aria-hidden="true"
  />
</button>

<nav
  id="nav-main"
  class="hidden h-[90dvh] w-full flex-col items-center justify-center bg-black-deep/95 backdrop-blur-xl lg:flex lg:h-auto lg:w-auto lg:bg-transparent lg:backdrop-blur-none"
  aria-label="navegación principal"
>
  <ul role="list" class="flex flex-col items-center lg:flex-row lg:gap-8">
    {linkNavbar.map((link) => {
      return (
        <li>
          <Link
            {...link}
            className="mt-12 text-gray-blue transition-colors duration-200 hover:text-gray-light lg:mt-0"
          />
        </li>
      );
    })}

    <li class="mt-8 border-t-2 border-gray-muted pt-8 lg:mt-0 lg:border-t-0 lg:border-l-2 lg:pt-0 lg:pl-8">
      <Link
        url=""
        label="Descargar CV"
        icon="lucide:download"
        download
        className="rounded-xl bg-indigo-vibrant px-4 py-2 font-semibold text-gray-light transition-all duration-200 hover:bg-indigo-soft hover:shadow-md hover:shadow-indigo-vibrant/20 active:scale-95"
      />
    </li>
  </ul>
</nav>

<script>
  let teardown: AbortController | null = null;

  const setupNavbar = () => {
    teardown?.abort();
    teardown = new AbortController();
    const { signal } = teardown;

    const btn = document.getElementById("menu-toggle");
    const nav = document.getElementById("nav-main");

    let open = false;

    const setOpen = (next: boolean) => {
      open = next;

      btn?.setAttribute("aria-expanded", String(open));

      nav?.classList.toggle("hidden", !open);
      nav?.classList.toggle("flex", open);
    };

    btn?.addEventListener("click", () => setOpen(!open), { signal });

    document.addEventListener(
      "keydown",
      (event) => {
        if (event.key === "Escape" && open) {
          setOpen(false);
          btn?.focus();
        }
      },
      { signal },
    );
    nav?.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false), { signal });

      link.addEventListener(
        "click",
        (e) => {
          setOpen(false);

          const href = link.getAttribute("href");
          if (href && href.includes("#")) {
            const hash = href.split("#")[1];
            const target = document.getElementById(hash);

            if (target && "startViewTransition" in document) {
              e.preventDefault();

              document.startViewTransition(() => {
                target.scrollIntoView({ behavior: "instant" });
                history.pushState(null, "", `#${hash}`);
              });
            }
          }
        },
        { signal },
      );
    });
  };

  document.addEventListener("astro:page-load", setupNavbar);
</script>
