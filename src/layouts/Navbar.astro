---
import { Icon } from "astro-icon/components";
import { linkNavbar } from "@data/links";
import Link from "@components/Link.astro";
---

<a
  href={import.meta.env.BASE_URL}
  class="flex items-center gap-2 text-gray-blue transition-all duration-200 hover:scale-105 hover:text-gray-light active:scale-95"
>
  <figure class="size-8">
    <img
      src={import.meta.env.BASE_URL + "favicon.png"}
      alt="Ir al inicio"
      loading="eager"
    />
  </figure>
  <span class="hidden md:block md:font-extrabold md:tracking-widest">
    14BryanEspinoza
  </span>
</a>

<button
  type="button"
  id="menu-toggle"
  class="cursor-pointer lg:hidden"
  aria-expanded="false"
  aria-controls="nav-main"
  aria-label="menú de navegación"
>
  <Icon
    name="lucide:menu"
    class="text-3xl text-gray-light transition-colors duration-200 hover:text-indigo-soft"
    aria-hidden="true"
  />
</button>

<nav
  id="nav-main"
  class="hidden h-[calc(100dvh-4rem)] w-full flex-col items-center overflow-y-auto bg-black-deep backdrop-blur-xl lg:flex lg:h-auto lg:w-auto lg:overflow-visible lg:bg-transparent lg:px-0 lg:py-0 lg:backdrop-blur-none"
  aria-label="navegación principal"
>
  <ul
    role="list"
    class="my-auto flex flex-col items-center lg:flex-row lg:gap-8"
  >
    {linkNavbar.map((link) => {
      return (
        <li>
          <Link
            {...link}
            className="mt-12 text-gray-blue transition-colors duration-200 hover:text-gray-light lg:mt-0"
          />
        </li>
      );
    })}

    <li class="mt-8 border-t-2 border-gray-muted pt-8 lg:mt-0 lg:border-t-0 lg:border-l-2 lg:pt-0 lg:pl-8">
      <Link
        url={import.meta.env.BASE_URL + "bryan-espinoza-cv.pdf"}
        label="Descargar CV"
        icon="lucide:download"
        download
        className="rounded-xl bg-indigo-vibrant px-4 py-2 font-semibold text-gray-light transition-all duration-200 hover:bg-indigo-deep hover:shadow-md hover:shadow-indigo-vibrant/20 active:scale-95"
      />
    </li>
  </ul>
</nav>

<script>
  let teardown: AbortController | null = null;

  const setupNavbar = () => {
    teardown?.abort();
    teardown = new AbortController();
    const { signal } = teardown;

    const btn = document.getElementById("menu-toggle");
    const nav = document.getElementById("nav-main");
    const main = document.getElementById("main-content");
    const footer = document.querySelector("footer");

    let open = false;

    const focusables = () =>
      Array.from(nav?.querySelectorAll<HTMLAnchorElement>("a[href]") ?? []);

    const setBackgroundInert = (inert: boolean) => {
      for (const node of [main, footer]) {
        if (!node) continue;
        if (inert) node.setAttribute("inert", "");
        else node.removeAttribute("inert");
      }
    };

    const setOpen = (next: boolean) => {
      open = next;

      btn?.setAttribute("aria-expanded", String(open));

      nav?.classList.toggle("hidden", !open);
      nav?.classList.toggle("flex", open);

      document.body.style.overflow = open ? "hidden" : "";
      setBackgroundInert(open);

      if (open) focusables()[0]?.focus();
    };

    btn?.addEventListener("click", () => setOpen(!open), { signal });

    document.addEventListener(
      "keydown",
      (event) => {
        if (!open) return;

        if (event.key === "Escape") {
          setOpen(false);
          btn?.focus();
          return;
        }

        if (event.key !== "Tab") return;

        const items = focusables();
        if (items.length === 0) return;

        const first = items[0];
        const last = items[items.length - 1];

        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      },
      { signal },
    );

    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    const desktopQuery = window.matchMedia("(min-width: 1024px)");

    desktopQuery.addEventListener(
      "change",
      (event: MediaQueryListEvent) => {
        if (event.matches && open) setOpen(false);
      },
      { signal },
    );

    nav?.querySelectorAll("a").forEach((link) => {
      link.addEventListener(
        "click",
        (event) => {
          setOpen(false);

          const href = link.getAttribute("href");
          if (!href?.includes("#")) return;

          const hash = href.split("#")[1];
          const target = document.getElementById(hash);

          if (!target) return;

          const moveFocus = () => {
            if (!target.hasAttribute("tabindex")) {
              target.setAttribute("tabindex", "-1");
            }
            target.focus({ preventScroll: true });
          };

          if (reduceMotion || !("startViewTransition" in document)) {
            moveFocus();
            return;
          }

          event.preventDefault();

          document.startViewTransition(() => {
            target.scrollIntoView({ behavior: "instant" });
            history.pushState(null, "", `#${hash}`);
          });
          moveFocus();
        },
        { signal },
      );
    });

    signal.addEventListener("abort", () => {
      document.body.style.overflow = "";
      setBackgroundInert(false);
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupNavbar, { once: true });
  } else {
    setupNavbar();
  }
</script>
