---
import { Icon } from "astro-icon/components";
import { linkNavbar } from "@data/links";
import Link from "@components/Link.astro";
---

<a
  href={import.meta.env.BASE_URL}
  class="flex items-center gap-2 text-text-bright transition hover:scale-105 hover:text-white"
>
  <figure class="size-8">
    <img
      src={import.meta.env.BASE_URL + "favicon.png"}
      alt="Ir al inicio"
      loading="eager"
    />
  </figure>
  <span class="text-sm font-bold tracking-wider">14BryanEspinoza</span>
</a>

<button
  type="button"
  id="menu-toggle"
  class="lg:hidden"
  aria-expanded="false"
  aria-controls="nav-main"
  aria-label="menú de navegación"
>
  <Icon
    name="lucide:menu"
    class="cursor-pointer text-3xl text-text-bright"
    aria-hidden="true"
  />
</button>

<nav
  id="nav-main"
  class="hidden h-[91dvh] w-full flex-col items-center justify-center lg:flex lg:h-auto lg:w-auto"
  aria-label="navegación principal"
>
  <ul role="list" class="flex flex-col items-center lg:flex-row lg:gap-8">
    {linkNavbar.map((link) => {
      return (
        <li>
          <Link {...link} className="mt-12 lg:mt-0" />
        </li>
      );
    })}

    <li class="mt-8 border-t border-text-muted pt-8 lg:mt-0 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-8">
      <Link
        url=""
        label="Descargar CV"
        icon="lucide:download"
        download
        className="rounded-md bg-brand px-4 py-2 text-white hover:bg-brand-hover"
      />
    </li>
  </ul>
</nav>

<script>
  const btn = document.getElementById("menu-toggle");
  const nav = document.getElementById("nav-main");

  let open = false;

  const setOpen = (next: boolean) => {
    open = next;

    btn?.setAttribute("aria-expanded", String(open));

    nav?.classList.toggle("hidden", !open);
    nav?.classList.toggle("flex", open);
  };

  btn?.addEventListener("click", () => setOpen(!open));

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && open) {
      setOpen(false);
      btn?.focus();
    }
  });

  nav?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setOpen(false));
  });
</script>
