---
import { contactEmail, socialNetworks } from "@data/links";
import ContainerText from "@components/ContainerText.astro";
import Section from "@components/Section.astro";
import Badged from "@components/Badged.astro";
import Link from "@components/Link.astro";
import Input from "@components/Input.astro";
import Button from "@components/Button.astro";

const formEndpoint = `https://formsubmit.co/${contactEmail}`;
const returnUrl = new URL(
  `${import.meta.env.BASE_URL}?sent=1#contact`,
  import.meta.env.SITE,
).href;
---

<Section id="contact" width="narrow">
  <ContainerText
    title="¿Tienes un proyecto en mente?"
    subtitle="Contacto"
    description="Estoy disponible para nuevos proyectos y oportunidades laborales.
        ¡Hablemos!"
    classNameDiv="text-center"
  />

  <div class="grid sm:grid-cols-2 sm:gap-6">
    <div class="mx-auto flex flex-col gap-2 md:w-full">
      <h3 class="mb-2 text-center text-sm font-bold tracking-widest text-gray-light uppercase">
        Información de contacto
      </h3>

      <Badged
        title="email"
        description={contactEmail}
        icon="simple-icons:gmail"
      />

      <Badged
        title="ubicación"
        description="Carazo, Nicaragua"
        icon="simple-icons:googlemaps"
      />
    </div>

    <div class="mx-auto flex flex-col gap-2 py-8 md:col-start-1 md:row-start-2">
      <h3 class="mb-2 text-center text-sm font-bold tracking-widest text-gray-light uppercase">
        Mis redes
      </h3>

      <div class="flex items-center justify-center gap-8">
        {socialNetworks.map((link) => (
          <Link
            url={link.url}
            ariaLabel={link.label}
            icon={link.icon}
            targ={!link.url.startsWith("mailto:")}
            className="text-gray-blue hover:border-gray-light hover:text-gray-light"
          />
        ))}
      </div>
    </div>

    <form
      id="contact-form"
      action={formEndpoint}
      method="POST"
      aria-label="Formulario de contacto"
      class="mx-auto grid w-full max-w-sm gap-6 rounded-2xl border border-gray-muted bg-black-dark p-6 sm:col-span-2 sm:gap-8 sm:p-8 md:col-start-2 md:row-span-2 md:row-start-1"
    >
      <p
        id="form-status"
        role="status"
        aria-live="polite"
        class="hidden rounded-xl border border-emerald-400/40 bg-emerald-400/10 px-4 py-3 text-center text-sm text-emerald-200"
      >
        Gracias, tu mensaje se envió correctamente. Te respondo a la brevedad.
      </p>
      <input type="hidden" name="_next" value={returnUrl} />
      <input
        type="hidden"
        name="_subject"
        value="Nuevo mensaje desde el portafolio"
      />
      <input
        type="text"
        name="_honey"
        class="hidden"
        tabindex="-1"
        autocomplete="off"
        aria-hidden="true"
      />

      <Input
        name="name"
        label="Nombre"
        type="text"
        placeholder="Tu nombre completo"
        autocomplete="name"
        maxlength={100}
        required
      />

      <Input
        name="email"
        label="Email"
        type="email"
        placeholder="tu@email.com"
        autocomplete="email"
        maxlength={100}
        required
      />

      <Input
        name="message"
        label="Mensaje"
        element="textarea"
        placeholder="Cuéntame sobre tu proyecto, plazos y objetivos"
        maxlength={1000}
        required
      />

      <Button type="submit" label="Enviar Mensaje" icon="lucide:send" />
    </form>
  </div>
</Section>

<script>
  const setupContactForm = () => {
    const form = document.querySelector<HTMLFormElement>("#contact-form");
    if (!form) return;

    const button = form.querySelector<HTMLButtonElement>(
      "button[type='submit']",
    );
    const label = button?.querySelector<HTMLElement>("[data-label]");

    if (button && label && !button.dataset.idleLabel) {
      button.dataset.idleLabel = label.textContent ?? "";
    }

    const resetButton = () => {
      if (!button) return;
      button.disabled = false;
      button.removeAttribute("aria-busy");
      if (label && button.dataset.idleLabel) {
        label.textContent = button.dataset.idleLabel;
      }
    };

    if (form.dataset.bound !== "true") {
      form.dataset.bound = "true";

      form.addEventListener("submit", () => {
        if (!button) return;
        button.disabled = true;
        button.setAttribute("aria-busy", "true");
        if (label) label.textContent = "Enviando...";
      });

      window.addEventListener("pageshow", (event) => {
        if (event.persisted) resetButton();
      });
    }

    const status = document.getElementById("form-status");
    if (!status) return;

    const url = new URL(window.location.href);
    if (url.searchParams.get("sent") !== "1") return;

    url.searchParams.delete("sent");
    history.replaceState(
      history.state,
      "",
      `${url.pathname}${url.search}${url.hash}`,
    );

    status.classList.remove("hidden");
    status.scrollIntoView({ block: "center" });
  };

  document.addEventListener("astro:page-load", setupContactForm);
  setupContactForm();
</script>
