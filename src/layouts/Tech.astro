---
import ContainerText from "@components/ContainerText.astro";
import TitleTech from "@components/TitleTech.astro";
import BadgedTech from "@components/BadgedTech.astro";
import {
  techFrontend,
  techTools,
  techBackend,
  techDatabase,
  techQuality,
  techIA,
} from "@data/tech.ts";

const groups = [
  { title: "Frontend", icon: "lucide:layout-dashboard", items: techFrontend },
  { title: "Herramientas", icon: "lucide:wrench", items: techTools },
  { title: "Backend", icon: "lucide:server", items: techBackend },
  { title: "Database", icon: "lucide:database", items: techDatabase },
  { title: "Calidad", icon: "lucide:check-check", items: techQuality },
  { title: "IA", icon: "lucide:brain", items: techIA },
];

const gridStyle =
  "grid grid-cols-1 gap-3 sm:grid-cols-2 md:grid-cols-1 xl:grid-cols-2";
---

<section id="stack" class="bg-black-deep py-20 md:py-24">
  <ContainerText
    title="Mi Tech Stack"
    subtitle="Habilidades"
    description="Tecnologías y herramientas que utilizo para dar vida a ideas y soluciones digitales."
    classNameDiv="text-center"
  />

  <div class="container mx-auto px-4 md:px-6">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2 md:gap-8">
      {groups.map((group) => (
        <div>
          <TitleTech title={group.title} icon={group.icon} />

          <div class={gridStyle}>
            {group.items.map((tech) => (
              <BadgedTech {...tech} />
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
