---
import ContainerText from "@components/ContainerText.astro";
import Motivation from "@components/Motivation.astro";
import Goals from "@components/Goals.astro";
import Info from "@components/Info.astro";
---

<section id="about" class="bg-black-deep py-20 md:py-24">
  <ContainerText
    title="Conoce mi Historia"
    subtitle="Sobre Mí"
    description="Un poco más sobre quién soy, qué me impulsa y hacia dónde voy en el
        mundo del desarrollo."
    classNameDiv="text-center"
  />

  <div class="mx-8 md:grid md:max-w-2xl md:gap-8 lg:max-w-7xl lg:grid-cols-2">
    <Motivation />

    <Goals />

    <Info />
  </div>
</section>
