---
interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  noindex?: boolean;
  canonical?: string;
}

import { meta } from "@metadata/meta";
import { socialNetworks } from "@data/links";
import JsonLd from "@components/JsonLd.astro";
import Navbar from "@layouts/Navbar.astro";
import Link from "@components/Link.astro";
import "../styles/global.css";

const {
  title,
  description,
  keywords,
  noindex = false,
  canonical,
} = Astro.props;

const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).href;

const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Bryan Espinoza",
  alternateName: meta.author,
  url: new URL(import.meta.env.BASE_URL, Astro.site).href,
  image: meta.image,
  jobTitle: "Frontend Developer",
  description: meta.description,
  sameAs: socialNetworks
    .map((network) => network.url)
    .filter((url) => url.startsWith("http")),
  knowsAbout: [
    "Astro",
    "React",
    "TypeScript",
    "Tailwind CSS",
    "Web Performance",
    "Web Accessibility",
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#030712" />

    <meta name="description" content={description || meta.description} />
    <meta name="keywords" content={keywords || meta.keywords} />
    <meta name="author" content={meta.author} />
    <meta
      name="robots"
      content={noindex ? "noindex, nofollow" : "index, follow"}
    />

    <meta property="og:title" content={title || meta.title} />
    <meta property="og:description" content={description || meta.description} />
    <meta property="og:site_name" content={meta.siteName} />
    <meta property="og:image" content={meta.image} />
    <meta property="og:image:alt" content={meta.imageAlt} />
    <meta property="og:image:type" content={meta.imageType} />
    <meta property="og:image:width" content={String(meta.imageWidth)} />
    <meta property="og:image:height" content={String(meta.imageHeight)} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={meta.locale} />
    {!noindex && <meta property="og:url" content={canonicalURL} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title || meta.title} />
    <meta
      name="twitter:description"
      content={description || meta.description}
    />
    <meta name="twitter:image" content={meta.image} />
    <meta name="twitter:image:alt" content={meta.imageAlt} />

    {!noindex && <link rel="canonical" href={canonicalURL} />}
    {!noindex && <JsonLd data={personJsonLd} />}

    <link
      rel="icon"
      type="image/png"
      href={import.meta.env.BASE_URL + "favicon.png"}
    />
    <link
      rel="apple-touch-icon"
      href={import.meta.env.BASE_URL + "favicon.png"}
    />

    <title>{title || meta.title}</title>
  </head>

  <body class="bg-black-deep">
    <Link url="#main-content" label="Saltar al contenido principal" skip />

    <header class="sticky top-0 z-40 flex flex-wrap items-center justify-between border-b border-gray-muted/70 bg-black-deep px-8 py-4 backdrop-blur-xl md:px-12 lg:px-16 lg:py-6">
      <Navbar />
    </header>

    <slot />
  </body>
</html>
